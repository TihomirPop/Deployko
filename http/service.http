### Variables
@host = http://localhost:8080
@serviceName = deployko-nginx
@imageRepository = docker.io/library/nginx
@imageVersion = latest
@hostPort = 8081
@hostProtocol = TCP
@containerPort = 80
@containerProtocol = TCP
@environmentVariableKey = APP_ENV
@environmentVariableValue = prod
@targetPath = /usr/share/nginx/html
@volumeMountType = BIND
@volumeMountSource = /home/tpopovic/dev/deployko-nginx
@volumeMountReadOnly = false

### Create service
POST {{host}}/services
Content-Type: application/json

{
  "name": "{{serviceName}}",
  "imageRepository": "{{imageRepository}}"
}

### Create duplicate service
POST {{host}}/services
Content-Type: application/json

{
  "name": "{{serviceName}}",
  "imageRepository": "{{imageRepository}}"
}

### Create invalid service
POST {{host}}/services
Content-Type: application/json

{
  "name": "Deployko Api",
  "imageRepository": "{{imageRepository}}"
}

### Delete service
DELETE {{host}}/services/{{serviceName}}

### Delete missing service
DELETE {{host}}/services/missing-service

### Delete invalid service
DELETE {{host}}/services/Deployko Api

### Get environment variables
GET {{host}}/services/{{serviceName}}/runtime-configuration/environment-variables

### Get environment variables missing service
GET {{host}}/services/missing-service/runtime-configuration/environment-variables

### Get port mappings
GET {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings

### Get port mappings missing service
GET {{host}}/services/missing-service/runtime-configuration/port-mappings

### Create port mapping
POST {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings
Content-Type: application/json

{
  "hostPort": {{hostPort}},
  "hostProtocol": "{{hostProtocol}}",
  "containerPort": {{containerPort}},
  "containerProtocol": "{{containerProtocol}}"
}

### Create duplicate port mapping
POST {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings
Content-Type: application/json

{
  "hostPort": {{hostPort}},
  "hostProtocol": "{{hostProtocol}}",
  "containerPort": {{containerPort}},
  "containerProtocol": "{{containerProtocol}}"
}

### Create port mapping missing service
POST {{host}}/services/missing-service/runtime-configuration/port-mappings
Content-Type: application/json

{
  "hostPort": {{hostPort}},
  "hostProtocol": "{{hostProtocol}}",
  "containerPort": {{containerPort}},
  "containerProtocol": "{{containerProtocol}}"
}

### Create invalid port mapping
POST {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings
Content-Type: application/json

{
  "hostPort": 70000,
  "hostProtocol": "{{hostProtocol}}",
  "containerPort": {{containerPort}},
  "containerProtocol": "{{containerProtocol}}"
}

### Delete port mapping
DELETE {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings/{{hostProtocol}}/{{hostPort}}

### Delete port mapping missing service
DELETE {{host}}/services/missing-service/runtime-configuration/port-mappings/{{hostProtocol}}/{{hostPort}}

### Delete missing port mapping
DELETE {{host}}/services/{{serviceName}}/runtime-configuration/port-mappings/{{hostProtocol}}/8081

### Get volume mounts
GET {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts

### Get volume mounts missing service
GET {{host}}/services/missing-service/runtime-configuration/volume-mounts

### Create volume mount
POST {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts
Content-Type: application/json

{
  "targetPath": "{{targetPath}}",
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Create duplicate volume mount
POST {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts
Content-Type: application/json

{
  "targetPath": "{{targetPath}}",
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Create volume mount missing service
POST {{host}}/services/missing-service/runtime-configuration/volume-mounts
Content-Type: application/json

{
  "targetPath": "{{targetPath}}",
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Create invalid volume mount
POST {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts
Content-Type: application/json

{
  "targetPath": "app/config",
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Update volume mount
PUT {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath={{targetPath}}
Content-Type: application/json

{
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Update volume mount missing service
PUT {{host}}/services/missing-service/runtime-configuration/volume-mounts?targetPath={{targetPath}}
Content-Type: application/json

{
  "mountType": "{{volumeMountType}}",
  "source": "{{volumeMountSource}}",
  "readOnly": {{volumeMountReadOnly}}
}

### Update missing volume mount
PUT {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath=/var/log/deployko
Content-Type: application/json

{
  "mountType": "VOLUME",
  "source": "deployko_logs",
  "readOnly": false
}

### Update invalid volume mount
PUT {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath=app/config
Content-Type: application/json

{
  "mountType": "VOLUME",
  "source": "deployko_config",
  "readOnly": false
}

### Delete volume mount
DELETE {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath={{targetPath}}

### Delete volume mount missing service
DELETE {{host}}/services/missing-service/runtime-configuration/volume-mounts?targetPath={{targetPath}}

### Delete missing volume mount
DELETE {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath=/var/log/deployko

### Delete invalid volume mount
DELETE {{host}}/services/{{serviceName}}/runtime-configuration/volume-mounts?targetPath=app/config

### Deploy
POST {{host}}/services/{{serviceName}}/runtime/deploy
Content-Type: application/json

{
  "imageVersion": "{{imageVersion}}"
}

### Deploy missing
POST {{host}}/services/missing-service/runtime/deploy
Content-Type: application/json

{
  "imageVersion": "{{imageVersion}}"
}

### Deploy invalid image version
POST {{host}}/services/{{serviceName}}/runtime/deploy
Content-Type: application/json

{
  "imageVersion": "feature/build"
}

### Start
POST {{host}}/services/{{serviceName}}/runtime/start

### Start missing
POST {{host}}/services/missing-service/runtime/start

### Start invalid
POST {{host}}/services/Deployko Api/runtime/start

### Stop
POST {{host}}/services/{{serviceName}}/runtime/stop

### Stop missing
POST {{host}}/services/missing-service/runtime/stop

### Stop invalid
POST {{host}}/services/Deployko Api/runtime/stop
